{
  "name": "range_factors",
  "description": "Size, Identification, Detection and OU, each alone. 1899 runs. Values are assumed, not measured.",
  "groups": [
    {"name": "no_error", "set": {"errors": []}},
    {"name": "size_scale", "set": {"errors": [{"type": "size"}]},
     "vary": {"errors.size.scale": [0.8, 0.9, 0.95, 1.05, 1.1, 1.2]}},
    {"name": "size_bias", "set": {"errors": [{"type": "size"}]},
     "vary": {"errors.size.bias_m": [-1.0, -0.5, -0.15, 0.15, 0.5, 1.0]}},
    {"name": "wrong_scale_1.77", "set": {"errors": [{"type": "identification", "wrong_scale": 1.77, "wrong_mean_s": 0.5}]},
     "vary": {"errors.identification.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "wrong_scale_0.91", "set": {"errors": [{"type": "identification", "wrong_scale": 0.91, "wrong_mean_s": 0.5}]},
     "vary": {"errors.identification.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "wrong_bias_+0.97", "set": {"errors": [{"type": "identification", "wrong_bias_m": 0.97, "wrong_mean_s": 0.5}]},
     "vary": {"errors.identification.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "wrong_bias_-1.45", "set": {"errors": [{"type": "identification", "wrong_bias_m": -1.45, "wrong_mean_s": 0.5}]},
     "vary": {"errors.identification.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "detection_iid", "set": {"errors": [{"type": "detection", "miss_model": "iid", "miss_rate": 0.1}]}, "seeds": 50},
    {"name": "detection_markov", "set": {"errors": [{"type": "detection", "miss_rate": 0.1}]},
     "vary": {"errors.detection.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50},
    {"name": "ou", "set": {"errors": [{"type": "ou"}]}, "vary": {"errors.ou.mae_pct": [0.8, 1.4]}, "seeds": 30}
  ]
}
