{
  "name": "range_factors",
  "description": "Size, Identification, Detection and OU, each alone. 1899 runs. Values are assumed, not measured.",
  "base": {"noise_correlation_time_s": 0.5},
  "groups": [
    {"name": "no_error", "set": {"uncertainty": "recorded_truth"}},
    {"name": "size_scale", "set": {"uncertainty": "range_factors"},
     "vary": {"range_factors.scale": [0.8, 0.9, 0.95, 1.05, 1.1, 1.2]}},
    {"name": "size_bias", "set": {"uncertainty": "range_factors"},
     "vary": {"range_factors.bias_m": [-1.0, -0.5, -0.15, 0.15, 0.5, 1.0]}},
    {"name": "wrong_scale_1.77", "set": {"uncertainty": "range_factors", "range_factors.wrong_scale": 1.77, "range_factors.wrong_mean_s": 0.5},
     "vary": {"range_factors.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "wrong_scale_0.91", "set": {"uncertainty": "range_factors", "range_factors.wrong_scale": 0.91, "range_factors.wrong_mean_s": 0.5},
     "vary": {"range_factors.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "wrong_bias_+0.97", "set": {"uncertainty": "range_factors", "range_factors.wrong_bias_m": 0.97, "range_factors.wrong_mean_s": 0.5},
     "vary": {"range_factors.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "wrong_bias_-1.45", "set": {"uncertainty": "range_factors", "range_factors.wrong_bias_m": -1.45, "range_factors.wrong_mean_s": 0.5},
     "vary": {"range_factors.wrong_rate": [0.01, 0.05, 0.2]}, "seeds": 30},
    {"name": "detection_iid", "set": {"uncertainty": "range_factors", "range_factors.miss_model": "iid", "range_factors.miss_rate": 0.1},
     "seeds": 50},
    {"name": "detection_markov", "set": {"uncertainty": "range_factors", "range_factors.miss_rate": 0.1},
     "vary": {"range_factors.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50},
    {"name": "ou", "set": {"uncertainty": "distance_ou_range"},
     "vary": {"noise_reference_mae_pct": [0.8, 1.4]}, "seeds": 30}
  ]
}
