{
  "name": "detection_seeds_50_99",
  "description": "Detection, seeds 50 to 99, to join seeds 0 to 49 of range_factors. 600 runs.",
  "base": {"uncertainty": "range_factors", "noise_correlation_time_s": 0.5, "range_factors.miss_rate": 0.1},
  "groups": [
    {"name": "detection_iid", "set": {"range_factors.miss_model": "iid"}, "seeds": {"first": 50, "count": 50}},
    {"name": "detection_markov", "vary": {"range_factors.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": {"first": 50, "count": 50}}
  ]
}
