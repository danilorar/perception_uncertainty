{
  "name": "lost_target",
  "description": "What the vehicle gets while the target is lost. 5 variants x 4 miss patterns x 3 scenarios x 50 seeds = 3000 runs.",
  "base": {"errors": [{"type": "detection", "miss_rate": 0.1, "lost_target": "predict"}]},
  "groups": [
    {"name": "predict_iid", "set": {"errors.detection.miss_model": "iid"}, "seeds": 50},
    {"name": "predict_markov", "vary": {"errors.detection.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50},
    {"name": "ou_predict_iid", "set": {"errors": [{"type": "ou", "mae_pct": 1.4},
       {"type": "detection", "miss_rate": 0.1, "lost_target": "predict", "miss_model": "iid"}]}, "seeds": 50},
    {"name": "ou_predict_markov", "set": {"errors": [{"type": "ou", "mae_pct": 1.4},
       {"type": "detection", "miss_rate": 0.1, "lost_target": "predict"}]},
     "vary": {"errors.detection.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50},
    {"name": "frozen_iid", "set": {"errors.detection.lost_target_motion": "frozen", "errors.detection.miss_model": "iid"}, "seeds": 50},
    {"name": "frozen_markov", "set": {"errors.detection.lost_target_motion": "frozen"},
     "vary": {"errors.detection.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50},
    {"name": "ou_frozen_iid", "set": {"errors": [{"type": "ou", "mae_pct": 1.4},
       {"type": "detection", "miss_rate": 0.1, "lost_target": "predict", "lost_target_motion": "frozen", "miss_model": "iid"}]},
     "seeds": 50},
    {"name": "ou_frozen_markov", "set": {"errors": [{"type": "ou", "mae_pct": 1.4},
       {"type": "detection", "miss_rate": 0.1, "lost_target": "predict", "lost_target_motion": "frozen"}]},
     "vary": {"errors.detection.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50},
    {"name": "ou_speed_iid", "set": {"errors": [{"type": "ou", "mae_pct": 1.4},
       {"type": "detection", "miss_rate": 0.1, "lost_target": "predict", "lost_target_motion": "frozen",
        "lost_target_distance": "frozen_object", "miss_model": "iid"}]}, "seeds": 50},
    {"name": "ou_speed_markov", "set": {"errors": [{"type": "ou", "mae_pct": 1.4},
       {"type": "detection", "miss_rate": 0.1, "lost_target": "predict", "lost_target_motion": "frozen",
        "lost_target_distance": "frozen_object"}]},
     "vary": {"errors.detection.miss_mean_s": [0.2, 0.5, 1.0]}, "seeds": 50}
  ]
}
